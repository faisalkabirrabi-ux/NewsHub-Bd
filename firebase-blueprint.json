{
  "entities": {
    "NewsArticle": {
      "title": "News Article",
      "description": "A news article entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "excerpt": { "type": "string" },
        "category": { "type": "string" },
        "source": { "type": "string" },
        "url": { "type": "string" },
        "imageUrl": { "type": "string" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "authorId": { "type": "string" },
        "isBreaking": { "type": "boolean" },
        "isHeadline": { "type": "boolean" }
      },
      "required": ["title", "content", "category", "source", "publishedAt"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Comment": {
      "title": "Article Comment",
      "description": "A comment left by a user on an article",
      "type": "object",
      "properties": {
        "articleId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["articleId", "userId", "userName", "text", "createdAt"]
    },
    "UserSession": {
      "title": "User Session",
      "description": "Tracks a user session and activity",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "startTime": { "type": "string", "format": "date-time" },
        "lastActive": { "type": "string", "format": "date-time" },
        "isOnline": { "type": "boolean" },
        "deviceInfo": { "type": "string" }
      },
      "required": ["startTime", "lastActive"]
    }
  },
  "firestore": {
    "articles": {
      "schema": "NewsArticle",
      "description": "Collection of news articles"
    },
    "users": {
      "schema": "UserProfile",
      "description": "Collection of user profiles"
    },
    "comments": {
      "schema": "Comment",
      "description": "Collection of comments on articles"
    },
    "sessions": {
      "schema": "UserSession",
      "description": "Collection of active user sessions"
    }
  }
}
